{
  "entities": {
    "site_settings": {
      "title": "Site Settings",
      "description": "Global website configuration such as the current live logo",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string", "description": "URL or data string of the site logo" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "site_content": {
      "title": "Site Content Texts",
      "description": "Editable headlines, paragraphs, about text, why-us items, and contact info",
      "type": "object",
      "properties": {
        "heroTitleLine1": { "type": "string" },
        "heroTitleHighlight": { "type": "string" },
        "heroDescription": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactWhatsApp": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "categories": {
      "title": "Categories",
      "description": "Product categories including custom added categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameArabic": { "type": "string" },
        "shortDesc": { "type": "string" },
        "description": { "type": "string" },
        "coverImage": { "type": "string" },
        "iconName": { "type": "string" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "coverImage"]
    },
    "category_covers": {
      "title": "Category Covers",
      "description": "Custom cover images for product categories",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string", "description": "ID of the category" },
        "coverImage": { "type": "string", "description": "URL or data string of the category cover photo" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["categoryId", "coverImage"]
    },
    "products": {
      "title": "Products",
      "description": "Handcrafted brass catalog products",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product English title" },
        "arabicName": { "type": "string", "description": "Product Arabic title" },
        "categoryId": { "type": "string", "description": "Category ID" },
        "dimensions": { "type": "string", "description": "Product dimensions" },
        "leadTime": { "type": "string", "description": "Manufacturing lead time" },
        "material": { "type": "string", "description": "Material specifications" },
        "description": { "type": "string", "description": "Product description" },
        "imageUrl": { "type": "string", "description": "Product image URL or data string" },
        "finishOptions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available metal finish options"
        },
        "isCustomizable": { "type": "boolean", "description": "Whether bespoke dimensions are available" },
        "isFeatured": { "type": "boolean", "description": "Featured on homepage" },
        "order": { "type": "number", "description": "Sort order" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "name", "categoryId", "imageUrl"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
