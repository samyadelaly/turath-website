{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/products/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot).*)"
        }
      ],
      "destination": "/api/share?slug=$1"
    },
    {
      "source": "/projects/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot).*)"
        }
      ],
      "destination": "/api/share?type=project&slug=$1"
    },
    { "source": "/share/(.*)", "destination": "/api/share?slug=$1" },
    { "source": "/p/(.*)", "destination": "/api/share?slug=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/products/(.*)", "destination": "/index.html" },
    { "source": "/projects/(.*)", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
