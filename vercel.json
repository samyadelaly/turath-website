{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/products/:category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebot|facebookcatalog|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|pinterest|discordbot|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share?type=product&category=:category&slug=:slug"
    },
    {
      "source": "/products/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebot|facebookcatalog|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|pinterest|discordbot|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share?type=product&slug=:slug"
    },
    {
      "source": "/projects/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebot|facebookcatalog|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|pinterest|discordbot|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share?type=project&slug=:slug"
    },
    { "source": "/share/product/:slug", "destination": "/api/share?type=product&slug=:slug" },
    { "source": "/share/project/:slug", "destination": "/api/share?type=project&slug=:slug" },
    { "source": "/share/:slug", "destination": "/api/share?slug=:slug" },
    { "source": "/p/:slug", "destination": "/api/share?slug=:slug" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
